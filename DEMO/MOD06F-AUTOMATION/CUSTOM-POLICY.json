{
  "properties": {
    "displayName": "Only Elastic Pool database",
    "policyType": "Custom",
    "mode": "Indexed",
    "description": "",
    "metadata": {
      "category": "Demo",
      "createdBy": "b8e50bc5-6559-4643-a003-2807a8d707f7",
      "createdOn": "2022-12-14T06:12:47.6492769Z",
      "updatedBy": null,
      "updatedOn": null
    },
    "parameters": {},
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Sql/servers/databases"
          },
          {
            "not": {
              "field": "Microsoft.Sql/servers/databases/elasticPoolId",
              "exists": "true"
            }
          }
        ]
      },
      "then": {
        "effect": "deny"
      }
    }
  }
}
